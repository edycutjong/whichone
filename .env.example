# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (the only required configuration; ≤ 26 credits per verdict, 0 on a cache hit)
NANSEN_API_KEY=nsn_your-key-here

# ── Optional ─────────────────────────────────────────────────
# Absolute origin used for Open Graph / Twitter image URLs (defaults to the Vercel alias)
# SITE_URL=https://whichone-edycutjong.vercel.app

# Spend guard on the public /api/verdict route (defaults shown; see apps/web/lib/guard.ts)
GUARD_IP_PER_MIN=6
GUARD_DAILY_CREDITS=3000
